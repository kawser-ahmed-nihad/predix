// PredictX BD - Prisma schema (MVP)
// Usage: put this at backend/prisma/schema.prisma, set DATABASE_URL in .env


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


// ---------- Enums ----------

enum Level {
  BRONZE
  SILVER
  GOLD
  DIAMOND
}

enum MatchStatus {
  UPCOMING
  LIVE
  FINISHED
  CANCELLED
}

enum MarketType {
  TOSS
  WINNER
  TOP_SCORER
  OVER_UNDER
  NEXT_OVER_BOUNDARY
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum MarketStatus {
  OPEN
  LOCKED
  RESOLVED
  CANCELLED
}

enum PredictionStatus {
  PENDING
  WON
  LOST
  REFUNDED
}

enum TxType {
  FREE_PREDICTION        // no balance change, for logging only
  PREDICTION_COST        // points deducted
  PREDICTION_REWARD      // tokens added
  PREDICTION_REFUND      // points returned
  DAILY_CHECKIN
  TASK_REWARD
  REFERRAL_REWARD
  SPIN_REWARD
  AD_REWARD
  WITHDRAWAL
  WITHDRAWAL_REFUND
  ADMIN_ADJUST
}

enum Currency {
  POINTS
  TOKENS
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  PAID
  REJECTED
}

enum ReferralStatus {
  PENDING     // friend joined, conditions not met yet
  SUCCESSFUL  // conditions met, reward given
}

enum TaskType {
  WATCH_AD
  JOIN_CHANNEL
  SHARE
  CUSTOM
}

// ---------- Users ----------

model User {
  id          Int      @id @default(autoincrement())
  telegramId  BigInt   @unique
  username    String?
  firstName   String?
  photoUrl    String?
  language    String   @default("bn")
  notifications Boolean @default(true)  // bot messages (reminders, wins)

  points      Int      @default(0)   // spendable on extra predictions
  tokens      Int      @default(0)   // earned from wins, withdrawable
  level       Level    @default(BRONZE)
  streak      Int      @default(0)
  bestStreak  Int      @default(0)
  winStreak   Int      @default(0)   // consecutive correct predictions
  lastCheckIn DateTime?

  referralCode String  @unique
  referrerId   Int?
  referrer     User?   @relation("Referrals", fields: [referrerId], references: [id])
  referred     User[]  @relation("Referrals")

  banned      Boolean  @default(false)
  isAdmin     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  predictions       Prediction[]
  transactions      Transaction[]
  userTasks         UserTask[]
  withdrawals       Withdrawal[]
  achievements      UserAchievement[]
  deviceLogs        DeviceLog[]
  referralsMade     Referral[] @relation("ReferrerSide")
  referralsReceived Referral[] @relation("ReferredSide")

  @@index([points])
  @@index([tokens])
}

// ---------- Matches & Markets ----------

model Match {
  id          Int         @id @default(autoincrement())
  externalId  String?     @unique // ID from cricket API
  sport       String      @default("cricket")
  tournament  String?
  teamA       String
  teamB       String
  teamALogo   String?
  teamBLogo   String?
  startTime   DateTime
  status      MatchStatus @default(UPCOMING)
  winner      String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  markets Market[]

  @@index([status, startTime])
}

model Market {
  id          Int          @id @default(autoincrement())
  matchId     Int
  match       Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  type        MarketType
  question    String
  options     Json         // e.g. ["Bangladesh","India"]
  difficulty  Difficulty   @default(EASY)
  reward      Int          // tokens for a correct prediction
  locksAt     DateTime     // checked on server time only
  status      MarketStatus @default(OPEN)
  result      String?      // winning option
  createdAt   DateTime     @default(now())

  predictions Prediction[]

  @@unique([matchId, type])
  @@index([status, locksAt])
}

model Prediction {
  id        Int              @id @default(autoincrement())
  userId    Int
  user      User             @relation(fields: [userId], references: [id])
  marketId  Int
  market    Market           @relation(fields: [marketId], references: [id])
  choice    String
  cost      Int              @default(0)  // 0 = free prediction
  isFree    Boolean          @default(true)
  status    PredictionStatus @default(PENDING)
  reward    Int              @default(0)
  multiplier Float           @default(1.0)
  createdAt DateTime         @default(now())
  settledAt DateTime?

  // one prediction per user per market
  @@unique([userId, marketId])
  @@index([userId, createdAt])
  @@index([marketId, status])
}

// ---------- Ledger (every balance change goes here) ----------

model Transaction {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  type         TxType
  currency     Currency
  amount       Int      // positive = credit, negative = debit
  balanceAfter Int
  refType      String?  // "prediction", "task", "withdrawal", ...
  refId        Int?
  note         String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([refType, refId])
}

// ---------- Tasks ----------

model Task {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  type        TaskType
  url         String?  // channel link, etc.
  rewardPoints Int     @default(0)
  daily       Boolean  @default(true)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  userTasks UserTask[]
}

model UserTask {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  taskId    Int
  task      Task      @relation(fields: [taskId], references: [id])
  day       DateTime  @db.Date // for daily tasks, which day
  completed Boolean   @default(false)
  claimed   Boolean   @default(false)
  claimedAt DateTime?

  @@unique([userId, taskId, day])
}

// ---------- Referrals ----------

model Referral {
  id         Int            @id @default(autoincrement())
  referrerId Int
  referrer   User           @relation("ReferrerSide", fields: [referrerId], references: [id])
  referredId Int            @unique // a user can be referred only once
  referred   User           @relation("ReferredSide", fields: [referredId], references: [id])
  status     ReferralStatus @default(PENDING)
  rewardPoints Int          @default(0)
  createdAt  DateTime       @default(now())
  completedAt DateTime?

  @@index([referrerId, status])
}

// ---------- Withdrawals ----------

model Withdrawal {
  id         Int              @id @default(autoincrement())
  userId     Int
  user       User             @relation(fields: [userId], references: [id])
  tokens     Int              // tokens spent
  rate       Decimal          @db.Decimal(12, 6) // taka per token on that day
  amountBdt  Decimal          @db.Decimal(12, 2)
  method     String           // bKash / Nagad / Rocket ...
  account    String
  status     WithdrawalStatus @default(PENDING)
  adminNote  String?
  txRef      String?          // payment transaction id after PAID
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([userId, createdAt])
  @@index([status])
}

// ---------- Achievements ----------

model Achievement {
  id          Int    @id @default(autoincrement())
  code        String @unique // GAME_MASTER, LUCKY_SPENDER, DAILY_STREAK, PREDICTION_PRO
  title       String
  description String?
  target      Int    // e.g. 50 correct predictions
  icon        String?

  users UserAchievement[]
}

model UserAchievement {
  id            Int         @id @default(autoincrement())
  userId        Int
  user          User        @relation(fields: [userId], references: [id])
  achievementId Int
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  progress      Int         @default(0)
  unlockedAt    DateTime?

  @@unique([userId, achievementId])
}

// ---------- Daily reward pool ----------

model AdRevenueDaily {
  id           Int      @id @default(autoincrement())
  day          DateTime @unique @db.Date
  revenueBdt   Decimal  @db.Decimal(12, 2)  // total ad income that day
  poolPercent  Decimal  @db.Decimal(5, 2)   // e.g. 35.00
  poolBdt      Decimal  @db.Decimal(12, 2)
  totalTokens  Int                           // all users' tokens at snapshot
  tokenRate    Decimal  @db.Decimal(12, 6)  // poolBdt / totalTokens
  createdAt    DateTime @default(now())
}

// ---------- Anti-fraud ----------

model DeviceLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  deviceHash String
  ip         String
  createdAt  DateTime @default(now())

  @@index([deviceHash])
  @@index([ip])
  @@index([userId])
}
